{
  "name": "high-performance-analyzer",
  "private": true,
  "version": "0.1.0",
  "description": "Web app to run URL discovery and performance analysis with k6 + Lighthouse.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-auto-port.mjs",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter @hpa/api test",
    "test:api": "pnpm --filter @hpa/api test",
    "test:e2e": "pnpm --filter @hpa/web test:e2e",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [
    "performance",
    "lighthouse",
    "k6",
    "vue",
    "typescript"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "lint-staged": {
    "*.{ts,tsx,js,vue,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.4",
    "vue-eslint-parser": "^10.4.0"
  }
}
